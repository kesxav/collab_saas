// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String      @id @default(uuid())
  username   String
  password   String
  email      String      @unique
  avatar     String?
  createdAt  DateTime    @default(now())
  workspaces Workspace[] @relation("UserWorkspaces")
  chats      Chat[]      @relation("chatsOwner")
}

model Workspace {
  id       String    @id @default(uuid())
  name     String
  ownerId  String
  owner    User      @relation("UserWorkspaces", fields: [ownerId], references: [id])
  channels Channel[] @relation("WorkspaceChannels")
}

model Channel {
  id          String    @id @default(uuid())
  name        String
  workspaceId String
  workspace   Workspace @relation("WorkspaceChannels", fields: [workspaceId], references: [id])
  chats       Chat[]    @relation("channelChats")
}

model Chat {
  id        String   @id @default(uuid())
  chat      String
  channelId String
  senderId  String
  channel   Channel  @relation("channelChats", fields: [channelId], references: [id])
  sender    User     @relation("chatsOwner", fields: [senderId], references: [id])
  createdAt DateTime @default(now())
}
